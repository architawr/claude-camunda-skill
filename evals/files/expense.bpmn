<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_expense" targetNamespace="http://bpmn.io/schema/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI"><bpmn:process id="expense" name="Expense Reimbursement" isExecutable="true"><bpmn:startEvent id="S" name="Expense submitted"><bpmn:outgoing>f1</bpmn:outgoing></bpmn:startEvent><bpmn:serviceTask id="CheckPolicy" name="Check policy"><bpmn:incoming>f1</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing></bpmn:serviceTask><bpmn:userTask id="Approve" name="Manager approval"><bpmn:incoming>f2</bpmn:incoming><bpmn:outgoing>f3</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="G" name="Approved?"><bpmn:incoming>f3</bpmn:incoming><bpmn:outgoing>f_yes</bpmn:outgoing><bpmn:outgoing>f_no</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="Reimburse" name="Reimburse employee"><bpmn:incoming>f_yes</bpmn:incoming><bpmn:outgoing>f4</bpmn:outgoing></bpmn:serviceTask><bpmn:endEvent id="EOk" name="Reimbursed"><bpmn:incoming>f4</bpmn:incoming></bpmn:endEvent><bpmn:endEvent id="ENo" name="Rejected"><bpmn:incoming>f_no</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="f1" sourceRef="S" targetRef="CheckPolicy" /><bpmn:sequenceFlow id="f2" sourceRef="CheckPolicy" targetRef="Approve" /><bpmn:sequenceFlow id="f3" sourceRef="Approve" targetRef="G" /><bpmn:sequenceFlow id="f_yes" sourceRef="G" targetRef="Reimburse"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${approved}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f_no" sourceRef="G" targetRef="ENo" /><bpmn:sequenceFlow id="f4" sourceRef="Reimburse" targetRef="EOk" /></bpmn:process><bpmndi:BPMNDiagram id="BPMNDiagram_expense">
    <bpmndi:BPMNPlane id="BPMNPlane_expense" bpmnElement="expense">
      <bpmndi:BPMNShape id="S_di" bpmnElement="S">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CheckPolicy_di" bpmnElement="CheckPolicy">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Approve_di" bpmnElement="Approve">
        <dc:Bounds x="325" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G_di" bpmnElement="G" isMarkerVisible="true">
        <dc:Bounds x="500" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Reimburse_di" bpmnElement="Reimburse">
        <dc:Bounds x="625" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EOk_di" bpmnElement="EOk">
        <dc:Bounds x="807" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ENo_di" bpmnElement="ENo">
        <dc:Bounds x="657" y="192" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2">
        <di:waypoint x="275" y="70" />
        <di:waypoint x="325" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3">
        <di:waypoint x="425" y="70" />
        <di:waypoint x="500" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_yes_di" bpmnElement="f_yes">
        <di:waypoint x="550" y="70" />
        <di:waypoint x="625" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_no_di" bpmnElement="f_no">
        <di:waypoint x="525" y="95" />
        <di:waypoint x="525" y="210" />
        <di:waypoint x="657" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f4_di" bpmnElement="f4">
        <di:waypoint x="725" y="70" />
        <di:waypoint x="807" y="70" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>